# Supabase local stack (run `supabase status` to read the anon key)
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Use the real API (BFF + agent-service) instead of mocks
NEXT_PUBLIC_USE_REAL_API=true

# BFF -> agent-service proxy wiring (must match the agent-service env)
AGENT_SERVICE_URL=http://localhost:8000
AGENT_INTERNAL_TOKEN=change-me
