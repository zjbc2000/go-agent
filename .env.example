# ============================================================
# Go-Agent — example local dev config.
#
# Copy this file to `.env` and fill in the values:
#   cp .env.example .env
#
# `.env` is git-ignored (never commit real secrets). This example
# file itself is also matched by `.gitignore`'s `.env.*` rule — force-add
# it with `git add -f .env.example` if you want it in the repo.
#
# Format is STRICT `KEY=value` — no surrounding spaces, no quotes,
# no inline comments. Put comments on their own `#` lines.
#
# Consumed by scripts/start.sh, which passes the backend vars to
# agent-service (uvicorn) and syncs the NEXT_PUBLIC_* + proxy vars into
# web/.env.local (Next.js reads those at build/dev time).
# ============================================================

# --- Frontend (Next.js) ---
# Public Supabase URL the browser talks to (local: kong on 54321).
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
# Supabase anon key. Get it from `supabase status` (field ANON_KEY).
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
# true = use the real BFF/agent stack; false = use in-memory mocks.
NEXT_PUBLIC_USE_REAL_API=true

# --- BFF -> agent-service proxy ---
# Base URL of the FastAPI agent-service. Port must match the uvicorn `--port`.
# (This machine uses 8010 because the local Supabase kong container shadows 8000.)
AGENT_SERVICE_URL=http://localhost:8010
# Shared token the BFF sends as `X-Internal-Token` to the agent-service.
# Must match what the agent-service is started with.
AGENT_INTERNAL_TOKEN=dev-e2e-token-12345

# --- Backend: Supabase (JWT verification + role load) ---
# The agent-service talks to Supabase server-side, so use 127.0.0.1, not localhost.
SUPABASE_URL=http://127.0.0.1:54321
# Anon key again (the backend also needs it for the PostgREST role load).
SUPABASE_ANON_KEY=your-supabase-anon-key
# JWKS URL is derived as <SUPABASE_URL>/auth/v1/.well-known/jwks.json — no need to set.

# --- Backend: RabbitMQ (skill/sandbox outbox) ---
# Only needed for skill/sandbox runs. Chat-only dev can leave it; the default
# amqp://guest:guest@127.0.0.1:5672/ is used when unset.
RABBITMQ_URL=amqp://guest:guest@127.0.0.1:5672/

# --- Backend: LLM provider (OpenAI-compatible chat/completions) ---
# Set all three to route chat through a real model. Leave them empty/blank to use
# the deterministic offline fake model (fixed text, used by tests/E2E).
# Empty values are treated as "not configured" by agent-service.
AGENT_PROVIDER_BASE_URL=https://api.deepseek.com/v1
AGENT_PROVIDER_API_KEY=your-api-key
AGENT_PROVIDER_MODEL=deepseek-v4-flash
